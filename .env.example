# Salin file ini menjadi .env lalu isi sesuai kebutuhan.

# Alamat database PostgreSQL (Neon / Supabase). Kosongkan untuk memakai SQLite lokal (server/data/riwp.db).
DATABASE_URL=

# Pemeriksaan SSL database: verify (bawaan, disarankan) | no-verify | off
DATABASE_SSL=verify
# Khusus Supabase: lokasi sertifikat CA yang diunduh dari dashboard Supabase
DATABASE_SSL_CA=

# (Opsional) Kode yang diminta saat membuat akun admin pertama.
# Kosongkan = admin pertama bisa dibuat tanpa kode.
SETUP_KODE=

# Lama sesi login admin (hari)
SESSION_DAYS=7

# Port server
PORT=3001
